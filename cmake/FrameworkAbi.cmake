# fw_sdk_check_abi()
#
# Refuses to configure a project whose toolchain cannot link the archive FrameworkManifest.cmake
# describes. Static libraries bind to the compiler lineage, the pointer size, the CRT and the
# standard-library mode; a mismatch here is a link error at best and a silent layout disagreement at
# worst. -DFW_SDK_SKIP_ABI_CHECK=ON turns it off for someone who knows better.
function(fw_sdk_check_abi)
    if(FW_SDK_SKIP_ABI_CHECK)
        message(STATUS "Framework SDK: ABI check skipped")
        return()
    endif()

    set(_problems "")
    if(NOT CMAKE_SIZEOF_VOID_P EQUAL FW_SDK_POINTER_SIZE)
        list(APPEND _problems "pointer size ${CMAKE_SIZEOF_VOID_P} (archive: ${FW_SDK_POINTER_SIZE})")
    endif()
    if(NOT CMAKE_CXX_COMPILER_ID STREQUAL FW_SDK_COMPILER_ID)
        list(APPEND _problems "compiler ${CMAKE_CXX_COMPILER_ID} (archive: ${FW_SDK_COMPILER_ID})")
    endif()
    if(MSVC)
        # MSVC links libraries from an older 14.x toolset under a newer one, never the reverse.
        math(EXPR _lineage "${MSVC_VERSION} / 100")
        math(EXPR _archive_lineage "${FW_SDK_MSVC_VERSION} / 100")
        if(NOT _lineage EQUAL _archive_lineage)
            list(APPEND _problems "MSVC ${MSVC_VERSION} is not the archive's lineage (${FW_SDK_MSVC_VERSION})")
        elseif(MSVC_VERSION LESS FW_SDK_MSVC_VERSION)
            list(APPEND _problems "MSVC ${MSVC_VERSION} is older than the archive's ${FW_SDK_MSVC_VERSION}")
        endif()
        if(NOT CMAKE_MSVC_RUNTIME_LIBRARY STREQUAL "MultiThreadedDLL")
            list(APPEND _problems "CMAKE_MSVC_RUNTIME_LIBRARY is '${CMAKE_MSVC_RUNTIME_LIBRARY}'; the archive needs MultiThreadedDLL (include FrameworkSetup before find_package)")
        endif()
    else()
        string(REGEX MATCH "^[0-9]+" _major "${CMAKE_CXX_COMPILER_VERSION}")
        string(REGEX MATCH "^[0-9]+" _archive_major "${FW_SDK_COMPILER_VERSION}")
        if(NOT _major STREQUAL _archive_major)
            list(APPEND _problems "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION} is not the archive's major (${FW_SDK_COMPILER_VERSION})")
        endif()
    endif()
    if(NOT CMAKE_CXX_STANDARD EQUAL FW_SDK_CXX_STANDARD)
        list(APPEND _problems "C++${CMAKE_CXX_STANDARD} (archive: C++${FW_SDK_CXX_STANDARD})")
    endif()
    if(DEFINED VCPKG_TARGET_TRIPLET AND NOT VCPKG_TARGET_TRIPLET STREQUAL FW_SDK_VCPKG_TRIPLET)
        list(APPEND _problems "vcpkg triplet ${VCPKG_TARGET_TRIPLET} (archive: ${FW_SDK_VCPKG_TRIPLET})")
    endif()

    if(_problems)
        list(JOIN _problems "\n  " _text)
        message(FATAL_ERROR "Framework SDK ${FW_SDK_VERSION} (${FW_SDK_PLATFORM}, ${FW_SDK_COMPILER_ID} ${FW_SDK_COMPILER_VERSION}) cannot be linked by this toolchain:\n  ${_text}")
    endif()
    message(STATUS "Framework SDK ${FW_SDK_VERSION} (${FW_SDK_PLATFORM}, ${FW_SDK_COMMIT})")
endfunction()
